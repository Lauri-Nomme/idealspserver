{
  "name": "xlsp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "xlsp": "cli.ts"
  },
  "scripts": {
    "build:linux-x64": "bun build cli.ts --compile --target=bun-linux-x64 --outfile ../../dist/xlsp-linux-x64",
    "build:linux-arm64": "bun build cli.ts --compile --target=bun-linux-arm64 --outfile ../../dist/xlsp-linux-arm64",
    "build:darwin-x64": "bun build cli.ts --compile --target=bun-darwin-x64 --outfile ../../dist/xlsp-darwin-x64",
    "build:darwin-arm64": "bun build cli.ts --compile --target=bun-darwin-arm64 --outfile ../../dist/xlsp-darwin-arm64",
    "build:windows-x64": "bun build cli.ts --compile --target=bun-windows-x64 --outfile ../../dist/xlsp-windows-x64.exe",
    "build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64 && bun run build:windows-x64"
  }
}
